{
  "custom/appmenu": {
    "format": "Apps",
    "on-click": "~/.config/1f2l-dotfiles/Scripts/launcher.sh",
    "on-click-right": "~/.config/1f2l-dotfiles/Scripts/keybindings.sh",
    "tooltip-format": "Left: Open the application launcher\nRight: Show all keybindings"
  },
  "custom/updates": {
    "format": "  {}",
    "escape": true,
    "return-type": "json",
    "exec": "~/.config/1f2l-dotfiles/Scripts/check-updates",
    "interval": 1800,
    "signal": 1,
    "hide-empty-text": true,
    "on-click": "~/.config/1f2l-dotfiles/Scripts/install-system-updates"
  },
  "custom/hyprshade": {
    "format": "",
    "tooltip-format": "Toggle Screen Shader",
    "on-click": "~/.config/1f2l-dotfiles/Scripts/toggle-hyprsunset",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "custom/exit": {
    "format": "",
    "on-click": "qs ipc call power toggle",
    "tooltip-format": "Open Power Menu"
  },
  "clock": {
    "format": "{:%I:%M:%S %p, %a.}",
    "interval": 1,
    "tooltip-format": "<big>{:%A, %B %d, %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<b>{}</b>",
        "weekdays": "<b>{}</b>",
        "weeks": "W{}",
        "today": "<span weight='bold' underline='double'>{}</span>"
      }
    }
  },
  "memory": {
    "format": "   Memory {}% ",
    "on-click": "btop",
    "on-scroll-up": "true",
    "on-scroll-down": "true"
  },
  "pulseaudio": {
    "max-volume": 200,
    "format": " {icon}   {volume}% {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": "Muted {icon} {format_source}",
    "format-muted": "Sound Muted {format_source}",
    "format-source": "",
    "format-source-muted": "",
    "format-icons": {
      "headphone": " ",
      "hands-free": " ",
      "headset": " ",
      "phone": " ",
      "portable": " ",
      "car": " ",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  }
}

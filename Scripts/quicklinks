#!/usr/bin/env bash
set -euo pipefail

config_file="$HOME/.quicklinks"
if [[ ! -f "$config_file" ]]; then
    printf 'Quicklinks file not found: %s\n' "$config_file" >&2
    printf 'Create entries in the format: Name | Description | Command\n' >&2
    exit 1
fi

selected_line=$(fzf \
    --style full \
    --height 40% \
    --layout reverse \
    --border \
    --prompt "Quick Access: " \
    --delimiter "|" \
    --with-nth 1..3 < "$config_file")

[[ -z "$selected_line" ]] && exit 0
command=$(cut -d'|' -f3- <<< "$selected_line" | sed 's/^[[:space:]]*//')
if [[ -z "$command" ]]; then
    printf 'Selected quicklink has no command.\n' >&2
    exit 1
fi

exec bash -c "$command"
